---
// layout
import Layout from "../../layouts/BaseLayout.astro"

// utils
import { formatDate } from "../../utils/formatDate";

// components
import Section from "../../components/elements/Section.astro";

// routing
import { type GetStaticPaths } from "astro";
import { render } from "astro:content";
import { getCollection } from "astro:content";
export const getStaticPaths = (async () => {
    const research = await getCollection("research");
    return research.map((article) => ({
        params: {
            page: article.data.slug
        },
        props: {
            article
        }
    }))
}) satisfies GetStaticPaths;

// props
const { article } = Astro.props;
const { Content } = await render(article);
const { title, category, publishedDate, abstract } = article.data;
const pdfPath = `${import.meta.env.BASE_URL}/papers/${article.data.pdfUrl.replace(/^\//, '')}`;
---

<Layout title={title}>
  <Section
    title={`Published On: ${formatDate(publishedDate)}`}
    titleHeading={`#${category}`}
  >
    <article>
      <h1 class="font-pixels text-base-200 text-40 uppercase mb-4">{title}</h1>

      <section class="markdown-content mb-8">
        <h2>Abstract</h2>
        <p>{abstract}</p>
      </section>

      <div class="pdf-actions flex gap-4 mb-8">
        <a href={pdfPath} download class="font-pixels text-base-100 text-20 px-4 py-2 border border-base-700 rounded hover:bg-base-900">Download PDF</a>
        <a href={pdfPath} target="_blank" rel="noopener" class="font-pixels text-base-100 text-20 px-4 py-2 border border-base-700 rounded hover:bg-base-900">Open in new tab</a>
      </div>

      <div class="pdf-viewer mb-8">
        <iframe
          src={`${pdfPath}#view=FitH`}
          title={`${title} PDF preview`}
          width="100%"
          height="800"
          style="border: 1px solid var(--border-color, #333);"
        ></iframe>
      </div>

      <section class="markdown-content">
        <Content />
      </section>
    </article>
  </Section>
</Layout>

