---
// layout
import Layout from "../../layouts/BaseLayout.astro"

// utils
import { formatDate } from "../../utils/formatDate";

// components
import Section from "../../components/elements/Section.astro";

// routing
import { type GetStaticPaths } from "astro";
import { render } from "astro:content";
import { getCollection } from "astro:content";
export const getStaticPaths = (async () => {
    const research = await getCollection("research");
    return research.map((article) => ({
        params: {
            page: article.data.slug
        },
        props: {
            article
        }
    }))
}) satisfies GetStaticPaths;

// props
const { article } = Astro.props;
const { Content } = await render(article);
const { title, category, publishedDate } = article.data;
const pdfPath = `${import.meta.env.BASE_URL}${article.data.pdfUrl.replace(/^\//, '')}`;
---

<Layout title={article.data.title}>
  <article>
    <h1>{article.data.title}</h1>
    <p class="date">{article.data.publishedDate.toLocaleDateString()}</p>

    <section class="abstract">
      <h2>Abstract</h2>
      <p>{article.data.abstract}</p>
    </section>

    <div class="pdf-actions">
      <a href={pdfPath} download class="btn">Download PDF</a>
      <a href={pdfPath} target="_blank" rel="noopener" class="btn">Open in new tab</a>
    </div>

    <div class="pdf-viewer">
      <iframe
        src={`${pdfPath}#view=FitH`}
        title={`${article.data.title} PDF preview`}
        width="100%"
        height="800"
        style="border: 1px solid var(--border-color, #333);"
      ></iframe>
    </div>

    <section class="body-content">
      <Content />
    </section>
  </article>
</Layout>

